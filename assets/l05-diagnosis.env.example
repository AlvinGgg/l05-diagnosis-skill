# Copy this file to ~/.codex/l05-diagnosis.env and set local values there.
# Keep the real file private. Do not place it in a repository, Vault, or chat.

JIRA_BASE_URL=https://jira.example.invalid
JIRA_TOKEN=
JIRA_AUTH_MODE=bearer
# JIRA_EMAIL=you@example.com

# L05_OBSIDIAN_VAULT=/absolute/path/to/knowledge-vault
# PAAS_KB_ROOT=/absolute/path/to/legacy-compatible-knowledge-vault
# L05_CODE_ROOTS=/absolute/path/to/code-root
# L05_DEFAULT_BRANCH=main
# L05_GITHUB_ACTIONS_WORKFLOW_REPO=/absolute/path/to/workflow-repository
