{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "L05 Provider Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provider_id", "display_name", "command", "capabilities", "request_schema", "response_schema"],
  "properties": {
    "schema_version": {"const": "l05-provider-manifest/v1"},
    "provider_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "display_name": {"type": "string", "minLength": 1},
    "command": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {"type": "string", "minLength": 1}
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,95}$"}
    },
    "request_schema": {"const": "l05-provider-request/v1"},
    "response_schema": {"const": "l05-provider-response/v1"}
  }
}
