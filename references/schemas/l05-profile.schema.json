{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/l05-diagnosis/schemas/l05-profile.schema.json",
  "title": "L05 Vault Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile_version", "language", "knowledge", "code"],
  "properties": {
    "profile_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/relativePath"
      },
      "required": [
        "contract",
        "index",
        "inbox_documents",
        "inbox_tickets",
        "inbox_jira",
        "raw_documents",
        "raw_tickets",
        "wiki_sources_documents",
        "wiki_sources_tickets",
        "wiki_sources_jira",
        "quality_reports"
      ]
    },
    "jira": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "field_mappings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "application": {"$ref": "#/$defs/stringArray"},
            "event_timestamp": {"$ref": "#/$defs/stringArray"},
            "request_type": {"$ref": "#/$defs/stringArray"},
            "question_classification": {"$ref": "#/$defs/stringArray"},
            "issue_category": {"$ref": "#/$defs/stringArray"},
            "environment": {"$ref": "#/$defs/stringArray"},
            "request_id": {"$ref": "#/$defs/stringArray"},
            "source_environment": {"$ref": "#/$defs/stringArray"},
            "subscription": {"$ref": "#/$defs/stringArray"},
            "target_environment": {"$ref": "#/$defs/stringArray"}
          }
        }
      }
    },
    "code": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositories", "routing_rules"],
      "properties": {
        "repositories": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "url", "roles"],
            "properties": {
              "id": {"$ref": "#/$defs/id"},
              "url": {"type": "string", "minLength": 1},
              "roles": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"$ref": "#/$defs/id"}
              },
              "default_ref": {"type": "string", "minLength": 1}
            }
          }
        },
        "routing_rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "match", "repositories", "reason"],
            "properties": {
              "id": {"$ref": "#/$defs/id"},
              "match": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "problem_types": {"$ref": "#/$defs/stringArray"},
                  "keywords": {"$ref": "#/$defs/stringArray"},
                  "components": {"$ref": "#/$defs/stringArray"},
                  "match_mode": {"enum": ["all", "any"]}
                },
                "anyOf": [
                  {"required": ["problem_types"]},
                  {"required": ["keywords"]},
                  {"required": ["components"]}
                ]
              },
              "repositories": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"$ref": "#/$defs/id"}
              },
              "reason": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_log_placements"],
      "properties": {
        "component_log_placements": {
          "type": "array",
          "maxItems": 50,
          "items": {"$ref": "#/$defs/componentLogPlacement"}
        }
      }
    },
    "optional_evidence_providers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider_id", "capabilities", "match", "config"],
        "properties": {
          "provider_id": {"$ref": "#/$defs/id"},
          "enabled": {"type": "boolean"},
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,95}$"}
          },
          "match": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "problem_types": {"$ref": "#/$defs/stringArray"},
              "keywords": {"$ref": "#/$defs/stringArray"},
              "components": {"$ref": "#/$defs/stringArray"},
              "match_mode": {"enum": ["all", "any"]}
            },
            "anyOf": [
              {"required": ["problem_types"]},
              {"required": ["keywords"]},
              {"required": ["components"]}
            ]
          },
          "config": {"type": "object"}
        },
        "allOf": [
          {
            "if": {
              "properties": {"provider_id": {"const": "kubectl"}},
              "required": ["provider_id"]
            },
            "then": {
              "properties": {
                "config": {"$ref": "#/$defs/kubectlConfig"}
              }
            }
          },
          {
            "if": {
              "properties": {"provider_id": {"const": "loki"}},
              "required": ["provider_id"]
            },
            "then": {
              "properties": {
                "capabilities": {
                  "items": {
                    "enum": [
                      "loki.gateway.health",
                      "loki.labels.list",
                      "loki.label.values",
                      "loki.stream.selector.resolve",
                      "loki.index.stats",
                      "loki.logs.query_excerpt",
                      "loki.logs.topk_api_status"
                    ]
                  }
                },
                "config": {"$ref": "#/$defs/lokiConfig"}
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\u0000]+$"
    },
    "stringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "componentLogPlacement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "component",
        "environment_keywords",
        "cluster_ref",
        "tenant_id",
        "stream_selector"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "component": {"$ref": "#/$defs/id"},
        "environment_keywords": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
          }
        },
        "cluster_ref": {"$ref": "#/$defs/id"},
        "tenant_id": {"$ref": "#/$defs/id"},
        "stream_selector": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "match"],
          "properties": {
            "label": {"const": "apiId"},
            "match": {"const": "nonempty"}
          }
        },
        "stream_selector_candidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["label", "value_source"],
                "properties": {
                  "label": {"enum": ["application", "apiId", "apis", "plugin_name", "productId", "project", "region", "tenant"]},
                  "value_source": {"enum": ["application", "log_identity"]}
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["label", "value_source", "value"],
                "properties": {
                  "label": {"enum": ["application", "apiId", "apis", "plugin_name", "productId", "project", "region", "tenant"]},
                  "value_source": {"const": "fixed"},
                  "value": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "pattern": "^[^\\u0000\\r\\n]+$"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "lokiConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gateways"],
      "properties": {
        "gateways": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cluster_ref", "gateway_url"],
            "properties": {
              "cluster_ref": {"$ref": "#/$defs/id"},
              "gateway_url": {
                "type": "string",
                "pattern": "^https://[^/?#]+/?$"
              }
            }
          }
        }
      }
    },
    "kubectlConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routes"],
      "properties": {
        "routes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "match", "cluster_alias"],
            "properties": {
              "id": {"$ref": "#/$defs/id"},
              "cluster_alias": {"$ref": "#/$defs/id"},
              "match": {
                "type": "object",
                "additionalProperties": false,
                "required": ["keywords", "match_mode"],
                "properties": {
                  "keywords": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 20,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
                    }
                  },
                  "match_mode": {"const": "any"}
                }
              }
            }
          }
        }
      }
    }
  }
}
